# Sao chép thành ".env" (cạnh docker-compose.yml). File này được docker compose VÀ backend (chạy tay) cùng đọc.
# Không commit file .env.

# --- MinIO (bắt buộc) --------------------------------------------------------------
# Tạo key ngẫu nhiên: python -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(40)))"
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MINIO_BUCKET=egazette
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# MINIO_BIND=127.0.0.1

# --- Database ----------------------------------------------------------------------
# Mặc định trỏ vào MySQL đi kèm compose (chạy bằng: docker compose --profile mysql up -d).
# Dùng MySQL có sẵn trên máy chủ: host.docker.internal (nhìn từ trong container). Ví dụ:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@host.docker.internal:3306/egazette?charset=utf8mb4

# --- Crawl -------------------------------------------------------------------------
# Key 2captcha. Trống thì hàng đợi crawl tạm dừng, xem/tìm kiếm vẫn dùng được.
APIKEY_2CAPTCHA=
# MIN_BALANCE=0.01
# HEADLESS=false          # false: Chromium có giao diện trên màn hình ảo trong container (khuyến nghị cho reCAPTCHA)
# Thư mục chứa 4 file Times New Roman của Windows (times, timesbd, timesi, timesbi .ttf), mount vào container cho bộ tách PDF
# PDF_FONT_DIR=C:/Windows/Fonts

# --- Web ---------------------------------------------------------------------------
# WEB_PORT=8080
# WEB_BIND=127.0.0.1      # 0.0.0.0 để máy khác truy cập: BẮT BUỘC đặt APP_USER / APP_PASSWORD (dữ liệu có CCCD, địa chỉ cá nhân)
# BACKEND_PORT=8000
# APP_USER=
# APP_PASSWORD=
# SECRET_KEY=
