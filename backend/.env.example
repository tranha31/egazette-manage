# Sao chép thành file ".env" rồi sửa. Mọi giá trị đều có mặc định hợp lý.

# --- MySQL (mặc định: container trong docker-compose.yml, cổng 3307)
DATABASE_URL=mysql+pymysql://egazette:egazette@127.0.0.1:3307/egazette?charset=utf8mb4
# Dùng MySQL khác: mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME?charset=utf8mb4

# --- Website
HOST=127.0.0.1
PORT=8000
# Mở cho nhiều người dùng trong mạng nội bộ: đặt HOST=0.0.0.0 VÀ đặt mật khẩu bên dưới (dữ liệu có CCCD, địa chỉ cá nhân)
APP_USER=
APP_PASSWORD=
SECRET_KEY=doi-chuoi-ngau-nhien-nay
# Frontend React nằm ở địa chỉ KHÁC backend (vd https://app.example.com): liệt kê origin, cách nhau bằng dấu phẩy.
# Để trống nếu frontend cùng địa chỉ (backend phục vụ thư mục build) hoặc chạy qua `npm run dev` (Vite tự chuyển tiếp /api).
# Lưu ý: bật APP_USER/APP_PASSWORD (HTTP Basic) thì nên cho frontend và backend CÙNG origin (qua reverse proxy)
# để trình duyệt tự nhớ mật khẩu cho cả file PDF.
CORS_ORIGINS=
# Thư mục frontend đã build (mặc định ../frontend/dist)
FRONTEND_DIST=

# --- 2captcha (hoặc tạo file api_key.txt chứa key)
APIKEY_2CAPTCHA=
MIN_BALANCE=0.01
# true: chạy ẩn trình duyệt (chưa kiểm chứng với trang bố cáo; nên để false)
HEADLESS=false

# --- Quy tắc crawl
APP_TZ=Asia/Ho_Chi_Minh
# Vừa crawl trong vòng N phút thì ngày hôm nay coi như đã đủ, không crawl lại
TODAY_RECHECK_MINUTES=60

# --- MinIO: nơi lưu file PDF (database chỉ lưu bucket + đường dẫn object, backend không giữ PDF trên đĩa)
# Cần một MinIO (hoặc dịch vụ tương thích S3) đang chạy. Bucket tự tạo khi khởi động nếu chưa có.
MINIO_ENDPOINT=127.0.0.1:9000          # host:port, KHÔNG kèm http://
# Key: dùng MinIO của docker compose thì đặt MINIO_ACCESS_KEY / MINIO_SECRET_KEY trong ../.env (cạnh docker-compose.yml,
# backend tự đọc); dùng MinIO khác thì đặt hai biến này ngay tại đây.
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
MINIO_BUCKET=egazette
MINIO_SECURE=false                     # true nếu MinIO chạy HTTPS
# PDF cũ còn nằm trên đĩa (bản trước khi dùng MinIO): nguồn cho `python -m app.migrate_pdfs`
LEGACY_STORAGE_DIR=./storage
